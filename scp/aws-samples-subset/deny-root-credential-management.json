{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRootCredentialManagementExceptBreakGlass",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateLoginProfile",
        "iam:DeleteLoginProfile",
        "iam:UpdateLoginProfile"
      ],
      "Resource": "arn:aws:iam::*:root",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/REPLACE_WITH_BREAK_GLASS_ROLE"
        }
      }
    }
  ]
}